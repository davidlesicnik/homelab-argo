      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "qmcgaw/ddns-updater"
    },
    {
      "customType": "regex",
      "description": "Update appVersion in Chart.yaml for dns",
      "managerFilePatterns": [
        "/^apps/dns/Chart\\.yaml$/"
      ],
      "matchStrings": [
        "appVersion:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "coredns/coredns"
    },
    {
      "customType": "regex",
      "description": "Update appVersion in Chart.yaml for nextcloud",
      "managerFilePatterns": [
        "/^apps/nextcloud/Chart\\.yaml$/"
      ],
      "matchStrings": [
        "appVersion:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "nextcloud"
    }
  ],
  "packageRules": [
    {
      "description": "Group all *arr apps (Sonarr, Radarr, Prowlarr, Lidarr) together",
      "groupName": "arr-stack",
      "matchDatasources": [
        "docker",
        "helm"
      ],
      "schedule": [
        "before 5am on monday"
      ],
      "matchPackageNames": [
        "/linuxserver/(sonarr|radarr|prowlarr|lidarr)/"
      ]
    },
    {
      "description": "Group Immich multi-container updates",
      "groupName": "immich",
      "matchDatasources": [
        "docker"
      ],
      "schedule": [
        "before 5am on tuesday"
      ],
      "matchPackageNames": [
        "/immich-app/immich/"
      ]
    },
    {
      "description": "Group monitoring stack (Prometheus, Grafana)",
      "groupName": "monitoring-stack",
      "matchDatasources": [
        "helm"
      ],
      "matchPackageNames": [
        "prometheus",
        "grafana"
      ],
      "schedule": [
        "before 5am on wednesday"
      ]
    },
    {
      "description": "Group infrastructure components",
      "groupName": "infrastructure",
      "matchDatasources": [
        "helm"
      ],
      "matchPackageNames": [
        "cert-manager",
        "external-secrets"
      ],
      "schedule": [
        "before 5am on thursday"
      ],
      "labels": [
        "infrastructure",
        "renovate"
      ]
    },
    {
      "description": "Pin latest tags to digest for stability",
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "matchCurrentVersion": "latest",
      "enabled": true,
      "pinDigests": true
    },
    {
      "description": "Slower cadence for apps using latest tag",
      "matchDatasources": [
        "docker"
      ],
      "matchCurrentVersion": "latest",
      "schedule": [
        "before 5am on saturday"
      ],
      "minimumReleaseAge": "7 days",
      "matchPackageNames": [
        "/qmcgaw/ddns-updater/",
        "/ghcr.io/hargata/lubelogger/",
        "/nextcloud/",
        "/redis/"
      ]
    },
    {
      "description": "Security updates - immediate with reduced stability",
      "matchUpdateTypes": [
        "patch"
      ],
      "matchDatasources": [
        "docker",
        "helm"
      ],
      "labels": [
        "security",
        "renovate"
      ],
      "minimumReleaseAge": "1 day",
      "matchPackageNames": [
        "/.*/"
      ]
    },
    {
      "description": "Major updates require manual review",
      "matchUpdateTypes": [
        "major"
      ],
      "matchDatasources": [
        "docker",
        "helm"
      ],
      "labels": [
        "major-update",
        "renovate"
      ],
      "minimumReleaseAge": "7 days",
      "schedule": [
        "before 5am on saturday"
      ]
    },
    {
      "description": "Minor and patch updates for stable apps",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchDatasources": [
        "docker"
      ],
      "groupName": "stable-apps",
      "schedule": [
        "before 5am on friday"
      ],
      "matchPackageNames": [
        "/actualbudget/actual-server/",
        "/linuxserver/qbittorrent/",
        "/linuxserver/sabnzbd/",
        "/tautulli/tautulli/",
        "/ghcr.io/wg-easy/wg-easy/",
        "/coredns/coredns/"
      ]
    },
    {
      "description": "Database images - extra caution",
      "matchDatasources": [
        "docker"
      ],
      "groupName": "databases",
      "separateMajorMinor": true,
      "separateMinorPatch": true,
      "minimumReleaseAge": "7 days",
      "labels": [
        "database",
        "renovate"
      ],
      "schedule": [
        "before 5am on saturday"
      ],
      "matchPackageNames": [
        "/postgres/",
        "/mariadb/",
        "/redis/"
      ]
    },
    {
      "description": "LinuxServer.io images - generally stable",
      "matchDatasources": [
        "docker"
      ],
      "separateMinorPatch": false,
      "minimumReleaseAge": "3 days",
      "matchPackageNames": [
        "/^linuxserver//"
      ]
    }
  ],
  "ignoreDeps": [],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    ".git/**"
  ]
}
