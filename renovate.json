{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard"
  ],
  "timezone": "Europe/Ljubljana",
  "schedule": [
    "after 10pm every weekday",
    "before 5am every weekday",
    "every weekend"
  ],
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "labels": [
    "renovate",
    "dependencies"
  ],
  "separateMajorMinor": true,
  "separateMultipleMajor": true,
  "automerge": false,
  "platformAutomerge": false,
  "commitMessagePrefix": "chore(deps):",
  "commitMessageAction": "update",
  "commitMessageTopic": "{{depName}}",
  "commitMessageExtra": "to {{newVersion}}",
  "rebaseWhen": "conflicted",
  "minimumReleaseAge": "3 days",
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ],
    "minimumReleaseAge": null
  },
  "helm-values": {
    "managerFilePatterns": [
      "/apps/.+/values\\.yaml$/"
    ]
  },
  "argocd": {
    "managerFilePatterns": [
      "/apps/.+/.*\\.yaml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/apps/.+/.*\\.yaml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update appVersion in Chart.yaml for actual",
      "managerFilePatterns": [
        "/^apps/actual/Chart\\.yaml$/"
      ],
      "matchStrings": [
        "appVersion:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "actualbudget/actual-server"
    },
    {
      "customType": "regex",
      "description": "Update appVersion in Chart.yaml for immich",
      "managerFilePatterns": [
        "/^apps/immich/Chart\\.yaml$/"
      ],
      "matchStrings": [
        "appVersion:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/immich-app/immich-server"
    },
    {
      "customType": "regex",
      "description": "Update appVersion in Chart.yaml for sonarr",
      "managerFilePatterns": [
        "/^apps/sonarr/Chart\\.yaml$/"
      ],
      "matchStrings": [
        "appVersion:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "linuxserver/sonarr"
    },
    {
      "customType": "regex",
      "description": "Update appVersion in Chart.yaml for radarr",
      "managerFilePatterns": [
        "/^apps/radarr/Chart\\.yaml$/"
      ],
      "matchStrings": [
        "appVersion:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "linuxserver/radarr"
    },
    {
      "customType": "regex",
      "description": "Update appVersion in Chart.yaml for prowlarr",
      "managerFilePatterns": [
        "/^apps/prowlarr/Chart\\.yaml$/"
      ],
      "matchStrings": [
        "appVersion:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "linuxserver/prowlarr"
    },
    {
      "customType": "regex",
      "description": "Update appVersion in Chart.yaml for lidarr",
      "managerFilePatterns": [
        "/^apps/lidarr/Chart\\.yaml$/"
      ],
      "matchStrings": [
        "appVersion:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "linuxserver/lidarr"
    },
    {
      "customType": "regex",
      "description": "Update appVersion in Chart.yaml for sabnzbd",
      "managerFilePatterns": [
        "/^apps/sabnzbd/Chart\\.yaml$/"
      ],
      "matchStrings": [
        "appVersion:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "linuxserver/sabnzbd"
    },
    {
      "customType": "regex",
      "description": "Update appVersion in Chart.yaml for tautulli",
      "managerFilePatterns": [
        "/^apps/tautulli/Chart\\.yaml$/"
      ],
      "matchStrings": [
        "appVersion:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "tautulli/tautulli"
    },
    {
      "customType": "regex",
      "description": "Update appVersion in Chart.yaml for qbittorrent",
      "managerFilePatterns": [
        "/^apps/qbittorrent/Chart\\.yaml$/"
      ],
      "matchStrings": [
        "appVersion:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "linuxserver/qbittorrent"
    },
    {
      "customType": "regex",
      "description": "Update appVersion in Chart.yaml for wg-easy",
      "managerFilePatterns": [
        "/^apps/wg-easy/Chart\\.yaml$/"
      ],
      "matchStrings": [
        "appVersion:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/wg-easy/wg-easy"
    },
    {
      "customType": "regex",
      "description": "Update appVersion in Chart.yaml for lubelogger",
      "managerFilePatterns": [
